# Virtualenvs and caches
.venv/
venv/
venv_visual/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# VCS and local scratch
.git/
.github/
.local-data/
.DS_Store

# Secrets never enter the build context
.env
.env.*

# Models are downloaded INSIDE the image by the `models` stage, never copied
# from the host. Keeping them out of the context avoids shipping ~2.3 GB to the
# daemon on every build.
models/

# Generated data: the image ships code, not someone's index.
output_frames/
temp_videos/
media/
*.db
*.sqlite3
feedback_log.json
*.log

# Tests and docs are not needed at runtime
tests/
DEPLOYMENT.md
