# SceneIt Environment Variables
# Copy to .env and fill in your own values. NEVER commit a real .env file.
# Every value here must stay a placeholder.

# --- YouTube Data API v3 (required only for trailer ingestion) ---
# Create at: https://console.cloud.google.com/apis/credentials
# Restrict the key to "YouTube Data API v3" only.
YOUTUBE_API_KEY=

# --- TMDB (optional: enriches titles with synopsis, cast and year) ---
# Create at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Storage paths (override in production / on a mounted volume) ---
# DB_PATH=sceneit.db
# OUTPUT_DIR=output_frames

# --- Flask ---
# FLASK_ENV=production
# FLASK_DEBUG=0
